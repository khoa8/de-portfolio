# Phase 02 PostgreSQL/Adminer settings
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=airflow
POSTGRES_HOST_PORT=5433

# Optional local Airflow settings. Airflow 3 SimpleAuthManager generates the
# UI password at first API-server startup; no UI password belongs in this file.
AIRFLOW_UID=50000
AIRFLOW_UI_USERNAME=airflow

# Phase 04 SQL Server source. The host must be reachable from the Airflow
# scheduler container; use host.docker.internal, a Compose service name, or a
# remote host only after verifying the actual topology.
MSSQL_HOST=replace_with_reachable_host
MSSQL_PORT=1433
MSSQL_DATABASE=EDW_Tech
MSSQL_USER=replace_me
MSSQL_PASSWORD=change_me
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false

# Phase 06 Google Cloud destination. Generate user ADC with
# `gcloud auth application-default login`; never commit the resulting file.
GCP_PROJECT_ID=kinetic-genre-473714-d1
GCS_BUCKET=edw_bucket_k
BQ_LOCATION=asia-southeast1
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=/Users/replace_me/.config/gcloud/application_default_credentials.json

# Phase 07 local streaming stack. Keep real passwords only in ignored
# airflow/.env. The database/topic names are intentionally non-secret.
MYSQL_CDC_ROOT_PASSWORD=change_me
# The CDC username is intentionally fixed as `debezium`; only its secret is
# environment-backed. The bootstrap grants narrowly scoped privileges.
MYSQL_CDC_PASSWORD=change_me
MYSQL_CDC_DATABASE=phase07_shop
MYSQL_CDC_HOST_PORT=3307
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONNECT_URL=http://connect:8083
KAFKA_CDC_TOPIC=phase07.phase07_shop.orders
PHASE07_CHECKPOINT_LOCATION=/opt/airflow/checkpoints/mysql_orders
